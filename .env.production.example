# Copy to .env (docker-compose.prod.yml reads this automatically for
# variable substitution). These configure the postgres/node-postgres/minio
# containers themselves — the backend's own DB/MinIO credentials go in
# backend/.env.production (see backend/.env.production.example) and must
# match what you set here.

POSTGRES_USER=eminidatabase_owner
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=eminidatabase

# The Data Plane Agent's tenant Postgres server (native agent, see
# docs/deploy-vps.md) — a single "postgres" superuser, not app-specific.
NODE_POSTGRES_PASSWORD=replace-with-a-long-random-password

MINIO_ROOT_USER=replace-with-a-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# This instance's own publicly reachable API origin — baked into the
# frontend's client bundle at build time (NEXT_PUBLIC_BACKEND_URL, used by
# the OAuth login buttons) and must match apidatabase.eminilabs.org's Apache
# vhost. See docs/deploy-vps.md.
PUBLIC_BACKEND_URL=https://apidatabase.eminilabs.org
