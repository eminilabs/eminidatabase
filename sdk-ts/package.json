{
  "name": "@eminidatabase/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client for the eminidatabase Control Plane API — thin per-endpoint wrappers, mirrors sdk/ (Python) 1:1.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/types.gen.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  }
}
