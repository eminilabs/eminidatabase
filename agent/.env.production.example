# Copy to agent/.env.production. Loaded by the eminidatabase-agent systemd
# unit (EnvironmentFile=) — the agent runs NATIVE on the host (not in
# Docker), see docs/deploy-vps.md for why.

# This instance's own public API origin.
CONTROL_PLANE_URL=https://apidatabase.eminilabs.org/api/v1

# One-shot token from `POST /api/v1/nodes/registration-tokens` (platform
# admin only) — only needed for the first `python bootstrap.py` run, see
# docs/deploy-vps.md. Discard/blank it out afterwards.
BOOTSTRAP_TOKEN=

REGION_CODE=eu-west
HOSTNAME=vps-srv1963488-a

# The docker-compose "internal" network's fixed gateway IP (see
# docker-compose.prod.yml's `networks.internal.ipam`) — this is what makes
# the agent's mTLS endpoint AND node-postgres directly reachable from the
# backend container, at a predictable address. Not this host's real public
# IP — deliberately not exposed to the internet (ufw has no rule for 9443).
IP_ADDRESS=172.20.0.1

AGENT_PORT=9443
HEARTBEAT_INTERVAL_SECONDS=20
STATE_DIR=/opt/projects/eminidatabase/agent/state

# node-postgres's host-published port (docker-compose.prod.yml) — the agent
# reaches it via loopback; the backend container reaches the same server via
# IP_ADDRESS above (same port, different bind address on the same container).
POSTGRES_PORT=5544
POSTGRES_ADMIN_DSN=postgresql://postgres:REPLACE_WITH_NODE_POSTGRES_PASSWORD@127.0.0.1:5544/postgres

# node-postgres runs in Docker (docker-compose.prod.yml), so pg_dump/pg_restore
# route through `docker exec` into that container rather than using local
# binaries — cf. agent/.env.example's comment on this being the non-native-
# Postgres pattern. Container name follows Compose v2's default
# <project>-<service>-<index> convention for `name: eminidatabase`.
PG_DUMP_COMMAND_PREFIX=docker,exec,-i,eminidatabase-node-postgres-1
PG_DUMP_HOST=127.0.0.1
PG_DUMP_PORT=5432

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

S3_ENDPOINT_URL=http://127.0.0.1:9010
S3_ACCESS_KEY=replace-with-the-minio-root-user-from-root-.env
S3_SECRET_KEY=replace-with-the-minio-root-password-from-root-.env
S3_BUCKET=eminidatabase-backups
S3_REGION=us-east-1
