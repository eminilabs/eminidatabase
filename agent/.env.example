# URL of the Control Plane API (no trailing slash).
CONTROL_PLANE_URL=https://control-plane.example.com/api/v1

# One-shot token from `POST /api/v1/nodes/registration-tokens` on the Control Plane.
# Only needed for the first `python bootstrap.py` run — discard it afterwards.
BOOTSTRAP_TOKEN=

REGION_CODE=eu-west

# Defaults to the machine's hostname if unset.
HOSTNAME=

# The IP the Control Plane should use to reach this agent's HTTPS listener.
# Required for the Control Plane to be able to call this node at all.
IP_ADDRESS=

AGENT_PORT=9443
HEARTBEAT_INTERVAL_SECONDS=20
STATE_DIR=./state

# --- Phase 3: this node's PostgreSQL ---
POSTGRES_PORT=5432
POSTGRES_ADMIN_DSN=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# --- Phase 5: backups ---
# In production, pg_dump/pg_restore are local binaries and this prefix is empty.
# In a sandbox where "this node's Postgres" is a Docker container without host
# client tools, route through `docker exec` instead — note the `-i` for stdin
# (pg_restore reads the dump on stdin) and that pg_dump host/port then need to be
# the container's *internal* address, not the host-mapped one:
#   PG_DUMP_COMMAND_PREFIX=docker,exec,-i,eminidb-node-postgres
#   PG_DUMP_HOST=127.0.0.1
#   PG_DUMP_PORT=5432
PG_DUMP_COMMAND_PREFIX=
PG_DUMP_HOST=127.0.0.1
PG_DUMP_PORT=5432

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=change-me

S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=eminidatabase-backups
S3_REGION=us-east-1
