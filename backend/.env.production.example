# Copy to backend/.env.production and fill in real values. Loaded by the
# backend, worker, scheduler, and migrate services in docker-compose.prod.yml
# (env_file:) — never bake secrets into the image itself.

ENVIRONMENT=production

# "postgres" is the Docker Compose service name (internal network), not a
# public host. Must match POSTGRES_USER/PASSWORD/DB in the root .env.
DATABASE_URL=postgresql+asyncpg://eminidatabase_owner:replace-with-a-long-random-password@postgres:5432/eminidatabase

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Fernet key encrypting database credentials at rest — NEVER reuse the dev
# default checked into app/core/config.py, it's public.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Where the mTLS internal CA (ca.key/ca.crt) and the Control Plane's own
# client certificate persist — backed by the certs-data volume. Regenerating
# this invalidates every already-registered node's certificate, so it must
# survive container restarts/redeploys (never point this at an ephemeral
# path).
CERTS_DIR=/srv/app/certs

# --- Optional integrations, deliberately disabled/sandbox at first deploy ---
# Resend (transactional email). "console" logs instead of sending — invites
# and password-reset emails won't actually be delivered until this is set.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@eminilabs.org
RESEND_API_KEY=

# NOWPayments (crypto payments) — leave blank to keep crypto payment
# attempts erroring gracefully rather than silently misconfigured.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true
NOWPAYMENTS_PUBLIC_API_URL=https://apidatabase.eminilabs.org
NOWPAYMENTS_DEFAULT_PAY_CURRENCY=usdtbsc
NOWPAYMENTS_PAYMENT_WINDOW_HOURS=3.0
NOWPAYMENTS_TOLERANCE_USD=0.50

# FedaPay (mobile money, West Africa)
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# OAuth sign-up/sign-in (Google, GitHub) — leave client id/secret blank to
# keep the buttons present but erroring instead of silently broken; the
# redirect URIs below must be registered with each provider once real
# credentials are added (.../api/v1/auth/oauth/google/callback, .../github/callback).
OAUTH_REDIRECT_BASE_URL=https://apidatabase.eminilabs.org
FRONTEND_OAUTH_REDIRECT_URL=https://database.eminilabs.org
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
