# Control Plane metadata database.
# Dev: Neon (or any managed Postgres) — metadata ONLY, never customer databases (Rule 19).
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=change-me

ENVIRONMENT=development

# Resend (transactional email) — "console" prints instead, no key needed for dev.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@eminidatabase.dev
RESEND_API_KEY=

# NOWPayments (crypto payments)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true
# This API's own publicly reachable base URL (for NOWPayments' IPN callback).
NOWPAYMENTS_PUBLIC_API_URL=http://localhost:8000
NOWPAYMENTS_DEFAULT_PAY_CURRENCY=usdtbsc
NOWPAYMENTS_PAYMENT_WINDOW_HOURS=3.0
NOWPAYMENTS_TOLERANCE_USD=0.50

# FedaPay (mobile money)
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# OAuth sign-up/sign-in (Google, GitHub). This API's own publicly reachable
# base URL — must match the redirect URI registered with each provider
# (.../api/v1/auth/oauth/google/callback and .../github/callback).
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
