# microfinance service's OWN metadata database (MFPlatformAccount, MFInstitution,
# MFStaffUser, MFJob) — never business data (cf. docs/architecture/08 §8.4). This is
# distinct from any institution's provisioned database.
CONTROL_DATABASE_URL=sqlite+aiosqlite:///./microfinance_control_dev.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=change-me

# Base URL of the eminidatabase Control Plane API this service is a client of.
PLATFORM_API_URL=http://127.0.0.1:8000/api/v1

# Bearer token gating POST /institutions (institution onboarding) — internal ops
# only, not self-service (cf. docs/architecture/08 §8.11). Generate with
# `python -m app.scripts.generate_operator_token` and put the printed HASH here;
# give the printed TOKEN to whoever runs onboarding.
MF_OPERATOR_TOKEN_HASH=change-me

ENVIRONMENT=development
